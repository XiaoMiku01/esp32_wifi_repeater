# ESP32-S3（开发板：8MB quad flash，2MB 片内 quad PSRAM）
# 其他 S3 板子按实际修改；N16R8 见 sdkconfig.defaults.n16r8
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Wi-Fi/lwIP 缓冲优先放 PSRAM，省内部 RAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 加大 Wi-Fi 收发缓冲与接收聚合窗口（默认：静态 RX 16、动态 RX 32、静态 TX 16、缓存 TX 32、BA 窗口 16），
# 转发流量大时少丢包、少重传；静态 RX / TX 缓冲在内部 RAM，合计多占约 40 KB
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32

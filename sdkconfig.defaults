# 各芯片通用配置；芯片相关的配置在 sdkconfig.defaults.<芯片>（构建时自动叠加在本文件之后）
# 未指定目标芯片时默认 ESP32-S3；其他芯片用 -D IDF_TARGET=<芯片> 或 idf.py set-target
CONFIG_IDF_TARGET="esp32s3"
# DIO：所有 flash 都支持（本板 EON flash 0x1c 在 bootloader 里设不上 QIE 位，QIO 不可用）
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 中继：IP 转发 + NAPT
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# 配置页：WebSocket 推送实时日志
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# 本机 AP 默认值（NVS 里没有保存过配置时使用，可在网页上修改）
CONFIG_REPEATER_AP_SSID="ESP32-Repeater"
CONFIG_REPEATER_AP_PASSWORD="12345678"

# httpd 9 + DNS 中继 2 + HTTP/2 监听 1 + 连接 3，默认 10 不够
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# HTTP/2 测试服务：TLS + nghttp2 使固件变大，改用 1.5MB 单应用分区（NVS 位置不变）
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 流量记录钩子运行在 tcpip 线程，加大栈
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

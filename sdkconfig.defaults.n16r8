# ESP32-S3 N16R8：16 MB flash + 8 MB Octal PSRAM（叠加在 sdkconfig.defaults 之上）
# 用法：idf.py -B build_n16r8 -D SDKCONFIG=build_n16r8/sdkconfig \
#         -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.n16r8" build
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Flash 沿用 DIO（所有 flash 都支持）；确认支持 QIO 时可改为 CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
